# Host port used by Docker Compose. Keep bound to localhost behind Caddy.
APP_PORT=3000

# Generate each value separately with: openssl rand -hex 32
SECRET_KEY=
ENCRYPTION_KEY=

# Optional: required only for records created by the legacy AES-CBC format.
# Generate with: openssl rand -hex 16
ENCRYPTION_IV=

# Used only if a separate frontend origin calls the API.
FRONTEND_ORIGIN=http://localhost:3000
