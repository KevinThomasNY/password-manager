# Host port used by Docker Compose. Keep bound to localhost behind Caddy.
APP_PORT=3000

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Legacy migration only. Keep the values from the previous installation until
# every existing user has logged in successfully, then remove both variables.
ENCRYPTION_KEY=
ENCRYPTION_IV=

# Used only if a separate frontend origin calls the API.
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY=true
